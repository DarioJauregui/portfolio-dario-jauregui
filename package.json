{
  "name": "portfolio-dario-jauregui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "check": "node node_modules/astro/bin/astro.mjs check",
    "build": "node node_modules/astro/bin/astro.mjs build",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "lint": "node node_modules/prettier/bin/prettier.cjs --check . && node node_modules/astro/bin/astro.mjs check",
    "test": "node --test tests/*.test.mjs",
    "pdf": "node scripts/generate-pdf.mjs",
    "build:full": "astro build && npm run pdf && astro build",
    "test:smoke": "node node_modules/@playwright/test/cli.js test",
    "check:links": "node scripts/check-links.mjs",
    "ci": "npm run lint && npm run test && npm run build:full && npm run check:links && npm run test:smoke"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
