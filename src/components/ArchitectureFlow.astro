---
interface Props {
  steps: string[];
  compact?: boolean;
  label?: string;
}
const { steps, compact = false, label = "Architecture flow" } = Astro.props;
---

<ol
  class:list={["architecture", { "architecture--compact": compact }]}
  aria-label={label}
>
  {steps.map((step, index) => (
    <li>
      <span>{String(index + 1).padStart(2, "0")}</span>
      {step}
    </li>
  ))}
</ol>
