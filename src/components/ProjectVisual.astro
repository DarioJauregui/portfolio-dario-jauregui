---
interface Props {
  code: string;
  lang: "es" | "en";
  compact?: boolean;
}
const { code, lang, compact = false } = Astro.props;
const diagrams = {
  P001: {
    es: ["Fuentes operativas", "Modelo común", "Productos y acceso"],
    en: ["Operational sources", "Shared model", "Products and access"],
  },
  P002: {
    es: ["Flujos en vivo", "API y contexto", "Pantalla continua"],
    en: ["Live streams", "API and context", "Continuous display"],
  },
  P003: {
    es: ["Calendario y contexto", "Predicción", "Escenarios y explicación"],
    en: ["Calendar and context", "Forecast", "Scenarios and explanation"],
  },
  P007: {
    es: ["Ficheros", "Reglas de conciliación", "Excepciones para revisión"],
    en: ["Files", "Reconciliation rules", "Exceptions for review"],
  },
} as const;
const captions = {
  P001:
    lang === "es"
      ? "Del dato disperso al producto compartido"
      : "From scattered data to a shared product",
  P002:
    lang === "es"
      ? "Información viva preparada para ser entendida"
      : "Live information made understandable",
  P003:
    lang === "es"
      ? "Predicción, escenarios y explicación en un mismo flujo"
      : "Forecasting, scenarios and explanation in one flow",
  P007:
    lang === "es"
      ? "La revisión humana se concentra en las diferencias"
      : "Human review focuses on differences",
} as const;
const diagram = diagrams[code as keyof typeof diagrams]?.[lang] ?? [code];
const caption = captions[code as keyof typeof captions] ?? code;
---

<figure
  class:list={[
    "project-visual",
    `project-visual--${code.toLowerCase()}`,
    { "project-visual--compact": compact },
  ]}
  aria-label={caption}
>
  <div class="visual-code">{code}</div>
  <div class="visual-flow">
    {diagram.map((step, index) => (
      <div class="visual-step">
        <span>{step}</span>
        {index < diagram.length - 1 && <i aria-hidden="true">→</i>}
      </div>
    ))}
  </div>
  <figcaption>{caption}</figcaption>
</figure>
