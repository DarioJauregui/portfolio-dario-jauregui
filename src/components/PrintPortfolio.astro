---
import type { CollectionEntry } from "astro:content";
import { profile } from "../data/profile";
import { site, withBase } from "../data/site";
import { ui, type Locale } from "../i18n/ui";

interface Props {
  lang: Locale;
  featured: CollectionEntry<"projects">[];
  timeline: CollectionEntry<"projects">[];
  lab: CollectionEntry<"lab">[];
}

const { lang, featured, timeline, lab } = Astro.props;
const t = ui[lang];
const p = profile[lang];
const featuredGroups = featured.map((project) => [project]);
const projectIndex = [...featured, ...timeline, ...lab].sort(
  (a, b) => a.data.order - b.data.order,
);
const evidence = {
  P001:
    lang === "es"
      ? "≈ 7 áreas de negocio · ≈ 20 paneles"
      : "≈ 7 business areas · ≈ 20 dashboards",
  P003:
    lang === "es"
      ? "WAPE 9,3 % · mejora ≈ 45,8 % · valoración 4,5/5"
      : "9.3% WAPE · ≈ 45.8% improvement · 4.5/5 rating",
  P004:
    lang === "es"
      ? "> 10 jornadas de trabajo ahorradas al mes"
      : "> 10 working days saved each month",
} as const;
---

<main class="print-portfolio">
  <section class="print-cover">
    <div class="print-cover-top">
      <span>PORTFOLIO / 2026</span>
      <span>{lang.toUpperCase()}</span>
    </div>
    <div>
      <p class="print-eyebrow">{site.role}</p>
      <h1>{site.name}</h1>
      <p class="print-location">{t.location}</p>
      <p class="print-statement">{t.statement}</p>
    </div>
    <div class="print-cover-bottom">
      <p>{site.email}</p>
      <p>linkedin.com/in/dariojauregui/</p>
      <p>github.com/DarioJauregui</p>
    </div>
  </section>

  <section class="print-page print-project-index">
    <header>
      <span>{lang === "es" ? "ÍNDICE" : "INDEX"}</span>
      <h2>{t.projects}</h2>
    </header>
    <p class="print-index-intro">{t.projectCount}</p>
    <ol class="print-index print-index--all">
      {projectIndex.map(({ data }) => (
        <li>
          <b>{data.code}</b>
          <span>
            <strong>{data.copy[lang].title}</strong>
            <small>
              {data.period[lang]}
              {data.level === "featured" && ` · ${t.fullCase}`}
            </small>
          </span>
        </li>
      ))}
    </ol>
  </section>

  {featuredGroups.map((group) => (
    <section class="print-page print-projects-page">
      {group.map(({ data }) => {
        const copy = data.copy[lang];
        const result = evidence[data.code as keyof typeof evidence];
        return (
          <article class="print-project">
            <header class="print-project-header">
              <div>
                <b>{data.code}</b>
                <small>{data.period[lang]}</small>
              </div>
              <small>{data.status[lang]}</small>
            </header>
            <h2>{copy.title}</h2>
            <p class="print-subtitle">{copy.subtitle}</p>
            <p class="print-deck">{copy.strapline}</p>
            {result && <p class="print-evidence">{result}</p>}
            {data.media && (
              <figure
                class:list={[
                  "print-project-media",
                  `print-project-media--${data.code.toLowerCase()}`,
                ]}
              >
                <img
                  src={withBase(data.media.src)}
                  width={data.media.width}
                  height={data.media.height}
                  alt={data.media.alt[lang]}
                />
                <figcaption>{data.media.caption[lang]}</figcaption>
              </figure>
            )}
            <div class="print-story">
              <div>
                <h3>{lang === "es" ? "Necesidad" : "Need"}</h3>
                <p>{copy.problem}</p>
              </div>
              <div>
                <h3>{lang === "es" ? "Solución" : "Solution"}</h3>
                <p>{copy.system}</p>
              </div>
              <div>
                <h3>{t.contribution}</h3>
                <p>{copy.contribution}</p>
              </div>
              <div>
                <h3>{lang === "es" ? "Resultado" : "Outcome"}</h3>
                <p>{copy.impact}</p>
              </div>
            </div>
            <div class="print-flow" aria-label={t.architecture}>
              {data.architecture[lang].map((step, index) => (
                <span>
                  <i>{String(index + 1).padStart(2, "0")}</i>
                  {step}
                </span>
              ))}
            </div>
            {copy.technical && (
              <p class="print-technical">
                <b>{t.technical}</b> · {copy.technical}
              </p>
            )}
            {data.repository && (
              <p class="print-repository">
                <b>GitHub</b> ·{" "}
                <a href={data.repository}>
                  {data.repository.replace("https://", "")}
                </a>
              </p>
            )}
          </article>
        );
      })}
    </section>
  ))}

  <section class="print-page print-archive">
    <header>
      <span>{lang === "es" ? "ARCHIVO" : "ARCHIVE"}</span>
      <h2>{t.allWork}</h2>
    </header>
    <div class="print-timeline">
      {timeline.map(({ data }) => (
        <article>
          <span>
            {data.code}
            <small>{data.period[lang]}</small>
          </span>
          <div>
            <h3>{data.copy[lang].title}</h3>
            <p>{data.copy[lang].strapline}</p>
            <p class="print-timeline-detail">{data.copy[lang].system}</p>
          </div>
        </article>
      ))}
    </div>
    <h2 class="print-lab-title">{t.lab}</h2>
    <div class="print-lab">
      {lab.map(({ data }) => (
        <article>
          <span>{data.code}</span>
          <h3>{data.copy[lang].title}</h3>
          <p>{data.copy[lang].strapline}</p>
          <small>{data.architecture[lang].join(" · ")}</small>
        </article>
      ))}
    </div>
  </section>

  <section class="print-page print-about-page">
    <header>
      <span>{lang === "es" ? "PERFIL" : "PROFILE"}</span>
      <h2>{t.profile}</h2>
    </header>
    <div class="print-about print-about--standalone">
      {p.map((paragraph, index) => (
        <p class:list={{ "print-lead": index === 0 }}>{paragraph}</p>
      ))}
    </div>
  </section>

  <section class="print-page print-contact">
    <div>
      <span>{lang === "es" ? "CONTACTO" : "CONTACT"}</span>
      <h2>{lang === "es" ? "¿Hablamos?" : "Let's talk"}</h2>
      <p>{t.contactLead}</p>
    </div>
    <address>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.linkedin}>linkedin.com/in/dariojauregui/</a>
      <a href={site.github}>github.com/DarioJauregui</a>
    </address>
    <p class="print-url">dariojauregui.github.io/portfolio-dario-jauregui/</p>
  </section>
</main>
