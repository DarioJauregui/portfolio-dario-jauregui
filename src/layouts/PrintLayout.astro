---
import "../styles/print.css";
import { site, withBase } from "../data/site";
import type { Locale } from "../i18n/ui";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  path: string;
}
const { lang, title, description, path } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link
      rel="canonical"
      href={new URL(withBase(`/${lang}${path}`), Astro.site)}
    />
    <title>{title} - {site.name}</title>
  </head>
  <body data-print-document>
    <slot />
  </body>
</html>
