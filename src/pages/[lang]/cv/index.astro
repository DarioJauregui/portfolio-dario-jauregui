---
import PrintCv from "../../../components/PrintCv.astro";
import { ui, type Locale } from "../../../i18n/ui";
import PrintLayout from "../../../layouts/PrintLayout.astro";

export function getStaticPaths() {
  return ["es", "en"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---

<PrintLayout
  lang={lang}
  title={ui[lang].downloadCv}
  description={ui[lang].statement}
  path="/cv/"
>
  <PrintCv lang={lang} />
</PrintLayout>
