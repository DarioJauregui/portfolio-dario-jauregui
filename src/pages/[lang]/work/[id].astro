---
import { getCollection, type CollectionEntry } from "astro:content";
import ArchitectureFlow from "../../../components/ArchitectureFlow.astro";
import ProjectVisual from "../../../components/ProjectVisual.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { withBase } from "../../../data/site";
import { ui, type Locale } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(
    ({ data }) => data.level === "featured",
  );
  return ["es", "en"].flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, id: project.data.code.toLowerCase() },
      props: { project },
    })),
  );
}

const { project } = Astro.props;
const lang = Astro.params.lang as Locale;
const data = project.data;
const copy = data.copy[lang];
const t = ui[lang];
const featured = (await getCollection("projects"))
  .filter(({ data }) => data.level === "featured")
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = featured.findIndex(
  ({ data: item }) => item.code === data.code,
);
const nextProject = featured[(currentIndex + 1) % featured.length]!.data;
const seoTitle = [copy.title, copy.subtitle].filter(Boolean).join(" - ");
---

<BaseLayout
  lang={lang}
  title={seoTitle}
  description={copy.strapline}
  path={`/work/${data.code.toLowerCase()}/`}
  image={null}
>
  <SiteHeader lang={lang} alternatePath={`/work/${data.code.toLowerCase()}/`} />
  <main id="main" class="case-study">
    <header class="case-hero shell">
      <a class="back-link" href={withBase(`/${lang}/#work`)}>
        ← {t.back}
      </a>
      <div class="case-meta">
        <span>{data.code}</span>
        <span>{data.period[lang]}</span>
        <span>{data.status[lang]}</span>
      </div>
      <div class="case-title-grid">
        <div>
          <h1>{copy.title}</h1>
          <p class="case-subtitle">{copy.subtitle}</p>
          <p class="case-deck">{copy.strapline}</p>
        </div>
        <ProjectVisual
          code={data.code}
          lang={lang}
          compact
          media={data.media}
        />
      </div>
    </header>

    <article class="case-article shell">
      <section class="case-article-section" aria-labelledby="context-title">
        <h2 id="context-title">
          {lang === "es" ? "Contexto y necesidad" : "Context and need"}
        </h2>
        <div class="case-prose">
          <p>{copy.context}</p>
          <p>{copy.problem}</p>
        </div>
      </section>

      <section class="case-article-section" aria-labelledby="solution-title">
        <h2 id="solution-title">
          {lang === "es" ? "Solución construida" : "Solution built"}
        </h2>
        <div class="case-prose">
          <p>{copy.system}</p>
        </div>
      </section>

      <section
        class="case-article-section"
        aria-labelledby="architecture-title"
      >
        <h2 id="architecture-title">
          {lang === "es" ? "Cómo funciona" : "How it works"}
        </h2>
        <div class="case-prose case-prose--wide">
          <ArchitectureFlow
            steps={data.architecture[lang]}
            label={t.architecture}
          />
        </div>
      </section>

      <section
        class="case-article-section"
        aria-labelledby="contribution-title"
      >
        <h2 id="contribution-title">{t.contribution}</h2>
        <div class="case-prose">
          <p>{copy.contribution}</p>
        </div>
      </section>

      <section class="case-article-section" aria-labelledby="result-title">
        <h2 id="result-title">{lang === "es" ? "Resultado" : "Outcome"}</h2>
        <div class="case-prose">
          <p class="case-result">{copy.impact}</p>
        </div>
      </section>

      {copy.technical && (
        <section
          class="case-article-section case-technical"
          aria-labelledby="tech-title"
        >
          <h2 id="tech-title">{t.technical}</h2>
          <div class="case-prose">
            <p>{copy.technical}</p>
          </div>
        </section>
      )}
    </article>

    <nav
      class="next-project shell"
      aria-label={lang === "es" ? "Siguiente proyecto" : "Next project"}
    >
      <span>{lang === "es" ? "Siguiente proyecto" : "Next project"}</span>
      <a href={withBase(`/${lang}/work/${nextProject.code.toLowerCase()}/`)}>
        <small>{nextProject.code}</small>
        <strong>{nextProject.copy[lang].title}</strong>
        <i aria-hidden="true">→</i>
      </a>
    </nav>
  </main>
</BaseLayout>
