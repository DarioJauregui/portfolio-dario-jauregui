---
import { getCollection, type CollectionEntry } from "astro:content";
import ArchitectureFlow from "../../../components/ArchitectureFlow.astro";
import ProjectVisual from "../../../components/ProjectVisual.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { withBase } from "../../../data/site";
import { ui, type Locale } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(
    ({ data }) => data.level === "featured",
  );
  return ["es", "en"].flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, id: project.data.code.toLowerCase() },
      props: { project },
    })),
  );
}

const { project } = Astro.props;
const lang = Astro.params.lang as Locale;
const data = project.data;
const copy = data.copy[lang];
const t = ui[lang];
const featured = (await getCollection("projects"))
  .filter(({ data }) => data.level === "featured")
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = featured.findIndex(
  ({ data: item }) => item.code === data.code,
);
const nextProject = featured[(currentIndex + 1) % featured.length]!.data;
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.strapline}
  path={`/work/${data.code.toLowerCase()}/`}
  image={null}
>
  <SiteHeader lang={lang} alternatePath={`/work/${data.code.toLowerCase()}/`} />
  <main id="main" class="case-study">
    <header class="case-hero shell">
      <a class="back-link" href={withBase(`/${lang}/#work`)}>
        ← {t.back}
      </a>
      <div class="case-kicker">
        <span>{String(data.order).padStart(2, "0")}</span>
        <div>
          <b>{data.code}</b>
          <small>{data.period[lang]}</small>
        </div>
      </div>
      <div class="case-title-grid">
        <div>
          <p class="eyebrow">{data.status[lang]}</p>
          <h1>{copy.title}</h1>
        </div>
        <p>{copy.strapline}</p>
      </div>
    </header>

    <div class="case-visual shell">
      <ProjectVisual code={data.code} lang={lang} />
    </div>

    <section
      class="case-section shell case-grid hairline"
      aria-labelledby="context-title"
    >
      <div class="case-aside">
        <span>01</span>
        <h2 id="context-title">
          {lang === "es" ? "Contexto y problema" : "Context and problem"}
        </h2>
      </div>
      <div class="case-copy case-copy--lead">
        <p>{copy.context}</p>
        <p>{copy.problem}</p>
      </div>
    </section>

    <section
      class="case-section shell case-grid hairline"
      aria-labelledby="system-title"
    >
      <div class="case-aside">
        <span>02</span>
        <h2 id="system-title">
          {lang === "es" ? "Sistema construido" : "System built"}
        </h2>
      </div>
      <div class="case-copy">
        <p class="case-large">{copy.system}</p>
        <h3>{t.architecture}</h3>
        <ArchitectureFlow steps={data.architecture[lang]} />
      </div>
    </section>

    <section
      class="case-section shell case-grid hairline"
      aria-labelledby="contribution-title"
    >
      <div class="case-aside">
        <span>03</span>
        <h2 id="contribution-title">{t.contribution}</h2>
      </div>
      <div class="case-copy split-copy">
        <div>
          <p>{copy.contribution}</p>
        </div>
        <div>
          <h3>{t.technologies}</h3>
          <ul class="stack-list">
            {data.stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="case-section case-impact" aria-labelledby="impact-title">
      <div class="shell case-grid">
        <div class="case-aside">
          <span>04</span>
          <h2 id="impact-title">{t.impact}</h2>
        </div>
        <div class="case-copy">
          <p class="impact-statement">{copy.impact}</p>
          <div class="publication-boundary">
            <h3>{t.confidentiality}</h3>
            <p>{copy.confidentiality}</p>
          </div>
        </div>
      </div>
    </section>

    <nav
      class="next-project shell hairline"
      aria-label={lang === "es" ? "Siguiente proyecto" : "Next project"}
    >
      <span>{lang === "es" ? "Siguiente case study" : "Next case study"}</span>
      <a href={withBase(`/${lang}/work/${nextProject.code.toLowerCase()}/`)}>
        <small>{nextProject.code}</small>
        <strong>{nextProject.copy[lang].title}</strong>
        <i>→</i>
      </a>
    </nav>
  </main>
</BaseLayout>
