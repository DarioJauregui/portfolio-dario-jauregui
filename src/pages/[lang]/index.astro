---
import { getCollection } from "astro:content";
import ArchitectureFlow from "../../components/ArchitectureFlow.astro";
import FeaturedCard from "../../components/FeaturedCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile, specialties } from "../../data/profile";
import { site, withBase } from "../../data/site";
import { ui, type Locale } from "../../i18n/ui";

export function getStaticPaths() {
  return ["es", "en"].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const allProjects = await getCollection("projects");
const labEntries = await getCollection("lab");
const featured = allProjects
  .filter(({ data }) => data.level === "featured")
  .sort((a, b) => a.data.order - b.data.order);
const timeline = allProjects
  .filter(({ data }) => data.level === "project")
  .sort((a, b) => b.data.period[lang].localeCompare(a.data.period[lang]));
const lab = labEntries.sort((a, b) => a.data.order - b.data.order);
const p = profile[lang];
const cvUrl = withBase(`/downloads/dario-jauregui-cv-${lang}.pdf`);
const portfolioUrl = withBase(
  `/downloads/dario-jauregui-portfolio-${lang}.pdf`,
);
---

<BaseLayout lang={lang} description={t.statement} path="/">
  <SiteHeader lang={lang} />

  <main id="main">
    <section class="hero shell" aria-labelledby="hero-title">
      <p class="hero-kicker">{t.eyebrow}</p>
      <h1 id="hero-title">{site.name}</h1>
      <div class="hero-intro">
        <div>
          <p class="hero-role">{site.role}</p>
          <p class="hero-location">{t.location}</p>
        </div>
        <div>
          <p class="statement">{t.statement}</p>
          <a class="arrow-link" href="#work">
            {t.viewWork}
          </a>
        </div>
      </div>
    </section>

    <section class="section shell" id="work" aria-labelledby="work-title">
      <SectionHeader
        title={t.selected}
        intro={
          lang === "es"
            ? "Una selección de productos donde datos, software y decisiones de ingeniería se convierten en herramientas reales."
            : "A selection of products where data, software and engineering decisions become practical tools."
        }
      />
      <div class="featured-grid">
        {featured.map((project) => (
          <FeaturedCard project={project} lang={lang} />
        ))}
      </div>
    </section>

    <section class="section shell" id="profile" aria-labelledby="profile-title">
      <SectionHeader title={t.profile} intro={t.profileLead} />
      <div class="profile-layout">
        <div class="profile-copy">
          <p>{p.intro}</p>
          <p>{p.context}</p>
          <p>{p.focus}</p>
          <p class="profile-scenario">{p.scenario}</p>
          <ul class="specialties" aria-label={t.technologies}>
            {specialties.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="trajectory">
          <h3>{lang === "es" ? "Trayectoria" : "Experience"}</h3>
          <div class="trajectory-list">
            {p.experience.map((item) => (
              <article>
                <p class="trajectory-period">{item.period}</p>
                <div>
                  <h4>{item.role}</h4>
                  <p class="organisation">{item.organisation}</p>
                  <p>{item.detail}</p>
                </div>
              </article>
            ))}
          </div>
          <h3>{lang === "es" ? "Formación" : "Education"}</h3>
          <ul class="education-list">
            {p.education.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a
            class="cv-link"
            href={cvUrl}
            download
            aria-label={`${t.downloadCv}`}
          >
            {t.downloadCv}
          </a>
        </div>
      </div>
    </section>

    <section
      class="section shell"
      id="timeline"
      aria-labelledby="timeline-title"
    >
      <SectionHeader
        title={t.timeline}
        intro={
          lang === "es"
            ? "Reporting, gobierno del dato, digitalización y prevención aplicados a necesidades concretas."
            : "Reporting, data governance, digitisation and prevention applied to specific needs."
        }
      />
      <div class="project-list">
        {timeline.map(({ data }) => {
          const copy = data.copy[lang];
          return (
            <article class="project-row">
              <div class="project-row-meta">
                <span>{data.period[lang]}</span>
                <span>{data.code}</span>
              </div>
              <div>
                <h3>{copy.title}</h3>
                <p>{copy.strapline}</p>
              </div>
              <p class="project-row-stack">
                {data.stack.slice(0, 3).join(" · ")}
              </p>
            </article>
          );
        })}
      </div>
    </section>

    <section class="section shell" id="lab" aria-labelledby="lab-title">
      <SectionHeader
        title={t.lab}
        intro={
          lang === "es"
            ? "Prototipos para seguir aprendiendo donde el software se encuentra con sensores, electrónica y mecanismos."
            : "Prototypes for continued learning where software meets sensors, electronics and mechanisms."
        }
      />
      <div class="lab-grid">
        {lab.map(({ data }) => {
          const copy = data.copy[lang];
          return (
            <article class="lab-card">
              <div class="lab-meta">
                <span>{data.code}</span>
                <span>{data.status[lang]}</span>
              </div>
              <h3>{copy.title}</h3>
              <p>{copy.strapline}</p>
              <ArchitectureFlow
                steps={data.architecture[lang]}
                compact
                label={t.architecture}
              />
              <p class="lab-stack">{data.stack.join(" · ")}</p>
            </article>
          );
        })}
      </div>
    </section>

    <section
      class="section contact-section shell"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div class="contact-copy">
        <h2 id="contact-title">
          {lang === "es" ? "¿Hablamos?" : "Let's talk"}
        </h2>
        <p>{t.contactLead}</p>
      </div>
      <div class="contact-details">
        <a class="contact-email" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        <div class="contact-links">
          <a href={site.linkedin} rel="me">
            LinkedIn ↗
          </a>
          <a href={site.github} rel="me">
            GitHub ↗
          </a>
          <a href={cvUrl} download>
            {lang === "es" ? "CV en PDF ↗" : "Résumé PDF ↗"}
          </a>
          <a href={portfolioUrl} download>
            {t.downloadPortfolio} ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer shell">
    <p>
      © {new Date().getFullYear()} {site.name}
    </p>
    <p>
      {site.role} · {t.location}
    </p>
    <a href="#main">{lang === "es" ? "Volver arriba ↑" : "Back to top ↑"}</a>
  </footer>
</BaseLayout>
