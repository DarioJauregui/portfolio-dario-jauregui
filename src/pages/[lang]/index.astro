---
import { getCollection } from "astro:content";
import ArchitectureFlow from "../../components/ArchitectureFlow.astro";
import FeaturedCard from "../../components/FeaturedCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile";
import { site, withBase } from "../../data/site";
import { ui, type Locale } from "../../i18n/ui";

export function getStaticPaths() {
  return ["es", "en"].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const allProjects = await getCollection("projects");
const labEntries = await getCollection("lab");
const featured = allProjects
  .filter(({ data }) => data.level === "featured")
  .sort((a, b) => a.data.order - b.data.order);
const timeline = allProjects
  .filter(({ data }) => data.level === "project")
  .sort((a, b) => a.data.order - b.data.order);
const lab = labEntries.sort((a, b) => a.data.order - b.data.order);
const projectIndex = [...allProjects, ...labEntries].sort(
  (a, b) => a.data.order - b.data.order,
);
const p = profile[lang];
const portfolioUrl = withBase(
  `/downloads/dario-jauregui-portfolio-${lang}.pdf`,
);
---

<BaseLayout lang={lang} description={t.statement} path="/">
  <SiteHeader lang={lang} />

  <main id="main">
    <section class="hero shell" aria-labelledby="hero-title">
      <p class="hero-kicker">{t.eyebrow}</p>
      <h1 id="hero-title">{site.name}</h1>
      <div class="hero-intro">
        <div>
          <p class="hero-role">{site.role}</p>
          <p class="hero-location">{t.location}</p>
        </div>
        <div>
          <p class="statement">{t.statement}</p>
          <a class="arrow-link" href="#projects">
            {t.viewWork}
          </a>
        </div>
      </div>
    </section>

    <section
      class="project-index-section shell"
      id="projects"
      aria-labelledby="project-index-title"
    >
      <header class="project-index-head">
        <h2 id="project-index-title">{t.projects}</h2>
        <p>{t.projectCount}</p>
      </header>
      <ol class="project-index-list">
        {projectIndex.map(({ data }) => (
          <li>
            <a
              href={`#${data.code.toLowerCase()}`}
              aria-label={`${data.copy[lang].title}, ${data.period[lang]}`}
            >
              <span class="project-index-code">{data.code}</span>
              <span class="project-index-title">
                <strong>{data.copy[lang].title}</strong>
                {data.level === "featured" && <small>{t.fullCase}</small>}
              </span>
              <span class="project-index-period">{data.period[lang]}</span>
              <span class="project-index-arrow" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="section shell" id="work" aria-labelledby="work-title">
      <SectionHeader
        id="work-title"
        title={t.selected}
        intro={
          lang === "es"
            ? "Una selección de productos donde datos, software y decisiones de ingeniería se convierten en herramientas reales."
            : "A selection of products where data, software and engineering decisions become practical tools."
        }
      />
      <div class="featured-grid">
        {featured.map((project) => (
          <FeaturedCard project={project} lang={lang} />
        ))}
      </div>
    </section>

    <section
      class="section shell"
      id="timeline"
      aria-labelledby="timeline-title"
    >
      <SectionHeader
        id="timeline-title"
        title={t.timeline}
        intro={
          lang === "es"
            ? "Reporting, gobierno del dato, digitalización y prevención aplicados a necesidades concretas."
            : "Reporting, data governance, digitisation and prevention applied to specific needs."
        }
      />
      <div class="project-list">
        {timeline.map(({ data }) => {
          const copy = data.copy[lang];
          return (
            <article class="project-row" id={data.code.toLowerCase()}>
              <div class="project-row-meta">
                <span>{data.period[lang]}</span>
                <span>{data.code}</span>
              </div>
              <div>
                <h3>{copy.title}</h3>
                <p>{copy.strapline}</p>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="section shell" id="lab" aria-labelledby="lab-title">
      <SectionHeader
        id="lab-title"
        title={t.lab}
        intro={
          lang === "es"
            ? "Prototipos para seguir aprendiendo donde el software se encuentra con sensores, electrónica y mecanismos."
            : "Prototypes for continued learning where software meets sensors, electronics and mechanisms."
        }
      />
      <div class="lab-grid">
        {lab.map(({ data }) => {
          const copy = data.copy[lang];
          return (
            <article class="lab-card" id={data.code.toLowerCase()}>
              <div class="lab-meta">
                <span>{data.code}</span>
                <span>{data.status[lang]}</span>
              </div>
              <h3>{copy.title}</h3>
              <p>{copy.strapline}</p>
              <ArchitectureFlow
                steps={data.architecture[lang]}
                compact
                label={t.architecture}
              />
            </article>
          );
        })}
      </div>
    </section>

    <section class="section shell" id="profile" aria-labelledby="profile-title">
      <SectionHeader id="profile-title" title={t.profile} />
      <div class="profile-editorial">
        {p.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <section
      class="section contact-section shell"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div class="contact-copy">
        <h2 id="contact-title">
          {lang === "es" ? "¿Hablamos?" : "Let's talk"}
        </h2>
        <p>{t.contactLead}</p>
      </div>
      <div class="contact-details">
        <a class="contact-email" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        <div class="contact-links">
          <a href={site.linkedin} rel="me">
            LinkedIn
          </a>
          <a href={site.github} rel="me">
            GitHub
          </a>
          <a href={portfolioUrl} download>
            {t.downloadPortfolio}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer shell">
    <p>
      © {new Date().getFullYear()} {site.name}
    </p>
    <p>
      {site.role} · {t.location}
    </p>
    <a href="#main">{lang === "es" ? "Volver arriba" : "Back to top"}</a>
  </footer>
</BaseLayout>
