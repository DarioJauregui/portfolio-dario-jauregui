---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../data/site";
---

<BaseLayout
  lang="es"
  title="404"
  description="Página no encontrada / Page not found"
  path="/404.html"
  noindex
>
  <main id="main" class="not-found shell">
    <p class="eyebrow">ERROR / 404</p>
    <h1>
      Ruta no encontrada.
      <br />
      <span>Path not found.</span>
    </h1>
    <div>
      <p>La página puede haber cambiado de dirección.</p>
      <p>This page may have moved.</p>
    </div>
    <nav aria-label="Language">
      <a class="arrow-link arrow-link--right" href={withBase("/es/")}>
        Volver al portfolio
      </a>
      <a class="arrow-link arrow-link--right" href={withBase("/en/")}>
        Return to the portfolio
      </a>
    </nav>
  </main>
</BaseLayout>
